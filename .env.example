# Bore & Barrel — Environment Variables
# Copy this file to .env and fill in the values.

# Base URL for the RESTful API backend (Modul 5)
# The university lab server for Prak PPB Modul 5.
# Set this in Vercel Project Settings > Environment Variables for production.
VITE_API_BASE_URL=https://modlima.fuadfakhruz.id

# Optional: set to "true" when public.products has an archived_at column.
# Archive/restore then also PATCH the column; otherwise the archive registry
# stays local to the browser (default behaviour).
# VITE_ARCHIVE_REMOTE=false
